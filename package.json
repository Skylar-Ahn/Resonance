{
  "name": "resonance-p001",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "check:git-policy": "python3 scripts/check_git_policy.py --tracked",
    "security:install": "python3 scripts/install_gitleaks.py",
    "hooks:install": "python3 scripts/install_git_hooks.py",
    "check:staged": "python3 scripts/run_git_checks.py pre-commit",
    "check:history": "python3 scripts/run_git_checks.py audit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
